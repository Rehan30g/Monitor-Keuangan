RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Isi setelah membuat widget Turnstile di dash.cloudflare.com
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# "Masuk dengan Google" (OAuth 2.0). Buat OAuth Client (tipe Web application) di
# Google Cloud Console -> APIs & Services -> Credentials. Authorized redirect URI
# HARUS persis: https://huzky.xyz/api/auth/google/callback
# Bila kosong, tombol Google disembunyikan & route /api/auth/google balas 501.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.5-flash-02-23
PUBLIC_BASE_URL=https://huzky.xyz

# Username (dipisah koma) yang otomatis dipromosikan jadi admin saat startup.
# Contoh: ADMIN_USERNAMES=rehan30g,timops
ADMIN_USERNAMES=

# Accounts service (identitas/sesi bersama, dipakai UangKu & imagegen) — lihat
# /root/accounts. INTERNAL_API_KEY harus sama persis di kedua .env.
ACCOUNTS_SERVICE_URL=http://127.0.0.1:3010
INTERNAL_API_KEY=
